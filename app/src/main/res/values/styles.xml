<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="PlayerDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_black</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@color/white_alpha_75</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAppearanceListItemSmall">@style/PlayerDialogItemText</item>
        <item name="textColorAlertDialogListItem">@android:color/white</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlNormal">@color/white_alpha_55</item>
    </style>

    <style name="PlayerDialogItemText" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Overflow (⋮) menu: black popup, white items -->
    <style name="PlayerPopupMenuTheme" parent="ThemeOverlay.AppCompat.Dark">
        <item name="popupMenuStyle">@style/PlayerPopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/PlayerPopupItemText</item>
        <item name="textAppearanceSmallPopupMenu">@style/PlayerPopupItemText</item>
    </style>

    <style name="PlayerPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_black</item>
    </style>

    <style name="PlayerPopupItemText" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>


    <style name="PlayerGlassAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">#F4F7FF</item>
    </style>

    <style name="GlassSurface">
        <item name="android:background">@drawable/bg_glass_surface</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="zxing_CaptureTheme" parent="Theme.AppCompat.NoActionBar">

        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
    </style>


    <style name="TvSettingsTab">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textColor">@color/ink_dim</item>
        <item name="android:textSize">@dimen/tv_text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/ink_dim</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/tv_focus_scale_sm</item>
    </style>

    <style name="Widget.Theme.MaxPlayer.ActionBar.Fullscreen" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="Widget.Theme.MaxPlayer.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>

    <style name="Theme.MaxPlayer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MaxPlayer</item>
    </style>


</resources>
