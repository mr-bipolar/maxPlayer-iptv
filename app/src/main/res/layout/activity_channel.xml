<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_primary_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="6dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/backChannelList"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_back"
            android:padding="10dp"
            android:background="@color/transparent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_back"
            app:tint="@color/ink" />
        <TextView
            android:id="@+id/categoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cat_sports"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/channelSort"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_sort"
            android:padding="10dp"
            android:background="@color/transparent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_sort"
            app:tint="@color/ink" />
    </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:background="@drawable/bg_search_field">
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_search"
                    android:importantForAccessibility="no"
                    app:tint="@color/ink_faint" />
                <EditText
                    android:id="@+id/channelSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search channels"
                    android:singleLine="true"
                    android:paddingStart="@dimen/space_12"
                    android:textSize="@dimen/text_body"
                    android:background="@android:color/transparent"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:id="@+id/channelsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_channel_count"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_view_toggle"
                    android:padding="3dp">
                    <LinearLayout
                        android:id="@+id/channelsList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_pill_accent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">
                        <ImageView
                            android:id="@+id/list_icon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_list"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="5dp"
                            app:tint="@color/accent_ink" />
                        <TextView
                            android:id="@+id/list_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/toggle_list"
                            android:textColor="@color/accent_ink"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/channelsGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">
                        <ImageView
                            android:id="@+id/grid_icon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_grid"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="5dp"
                            app:tint="@color/ink_faint" />
                        <TextView
                            android:id="@+id/grid_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/toggle_grid"
                            android:textColor="@color/ink_faint"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                android:overScrollMode="never"/>

            <ScrollView
                android:id="@+id/emptyChannelsView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="36dp"
                    android:paddingEnd="36dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_card_lg"
                        android:elevation="2dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_tv"
                            android:importantForAccessibility="no"
                            android:layout_gravity="center"
                            app:tint="@color/accent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No channels found"
                        android:textSize="@dimen/text_title"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="There are no channels in this category."
                        android:textSize="@dimen/text_body_sm"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        android:textColor="@color/ink_dim"
                        android:gravity="center"
                        android:maxWidth="280dp"
                        android:lineSpacingMultiplier="1.15" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

</LinearLayout>
