<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".navigates.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
       >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true"
            android:overScrollMode="never">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_18"
                    android:paddingEnd="@dimen/space_18"
                    android:layout_marginTop="@dimen/space_6"
                    android:layout_marginBottom="@dimen/space_12">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/section_my_playlists"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/addPlaylistBtn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_plus"
                        android:padding="@dimen/space_10"
                        android:background="@color/transparent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/cd_add"
                        app:tint="@color/ink" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:clipToOutline="true"
                        android:layout_marginEnd="6dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/playlist_art_height"
                            android:background="@drawable/bg_playlist_art">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_tv"
                                android:importantForAccessibility="no"
                                android:layout_gravity="center"
                                app:tint="@color/ink_faint" />
                            <FrameLayout
                                android:id="@+id/bookmarkIconView"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="top|start"
                                android:layout_margin="8dp"
                                android:visibility="invisible"
                                android:background="@drawable/bg_badge_overlay">
                                <ImageView
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:src="@drawable/ic_pin"
                                    android:importantForAccessibility="no"
                                    android:layout_gravity="center"
                                    app:tint="@color/accent" />
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/playlistMenuBtn"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_badge_overlay">
                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/ic_more_vert"
                                    android:importantForAccessibility="no"
                                    android:layout_gravity="center"
                                    app:tint="@color/ink" />
                            </FrameLayout>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/playlist_world_live_tv"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_body_sm"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/playlist_world_live_tv_sub"
                                android:textColor="@color/ink_faint"
                                android:textSize="@dimen/text_caption_sm"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:clipToOutline="true"
                        android:layout_marginStart="6dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/playlist_art_height"
                            android:background="@drawable/bg_playlist_art">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_tv"
                                android:importantForAccessibility="no"
                                android:layout_gravity="center"
                                app:tint="@color/ink_faint" />
                            <FrameLayout
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_badge_overlay">
                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/ic_more_vert"
                                    android:importantForAccessibility="no"
                                    android:layout_gravity="center"
                                    app:tint="@color/ink" />
                            </FrameLayout>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/playlist_sports_feed"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_body_sm"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/playlist_sports_feed_sub"
                                android:textColor="@color/ink_faint"
                                android:textSize="@dimen/text_caption_sm"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:clipToOutline="true"
                        android:layout_marginEnd="6dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/playlist_art_height"
                            android:background="@drawable/bg_playlist_art">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_tv"
                                android:importantForAccessibility="no"
                                android:layout_gravity="center"
                                app:tint="@color/ink_faint" />
                            <FrameLayout
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_badge_overlay">
                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/ic_more_vert"
                                    android:importantForAccessibility="no"
                                    android:layout_gravity="center"
                                    app:tint="@color/ink" />
                            </FrameLayout>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/playlist_family_mix"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_body_sm"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/playlist_family_mix_sub"
                                android:textColor="@color/ink_faint"
                                android:textSize="@dimen/text_caption_sm"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:clipToOutline="true"
                        android:layout_marginStart="6dp">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/playlist_art_height"
                            android:background="@drawable/bg_playlist_art">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_radio"
                                android:importantForAccessibility="no"
                                android:layout_gravity="center"
                                app:tint="@color/ink_faint" />
                            <FrameLayout
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_badge_overlay">
                                <ImageView
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/ic_more_vert"
                                    android:importantForAccessibility="no"
                                    android:layout_gravity="center"
                                    app:tint="@color/ink" />
                            </FrameLayout>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/playlist_radio_stations"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_body_sm"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/playlist_radio_stations_sub"
                                android:textColor="@color/ink_faint"
                                android:textSize="@dimen/text_caption_sm"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_mini_player">
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_card_icon_square_sm">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_tv"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center"
                    app:tint="@color/ink_faint" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/now_playing_bbc"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_circle_live"
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/now_playing_bbc_sub"
                        android:textColor="@color/ink_faint"
                        android:textSize="@dimen/text_caption_sm"
                        android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_pause"
                android:padding="8dp"
                android:background="@color/transparent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/cd_pause"
                app:tint="@color/ink" />
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_expand"
                android:padding="8dp"
                android:background="@color/transparent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/cd_expand"
                app:tint="@color/ink" />
        </LinearLayout>

    </LinearLayout>

    <!-- Empty State View -->
    <include
        android:id="@+id/layoutHomeEmpty"
        layout="@layout/fragment_home_empty"
        android:visibility="visible" />
</FrameLayout>