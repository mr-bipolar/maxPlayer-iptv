<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
   >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_drawer_sheet"
        android:orientation="vertical"
        android:minHeight="400dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_drawer_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/topLabelView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/drawer_header"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_title_sm"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/searchButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@color/transparent"
                android:contentDescription="@string/cd_search"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search"
                app:tint="@color/ink" />
        </LinearLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/channelSearchLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_8"
            android:hint="Search channels"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="@dimen/space_12"
            app:boxCornerRadiusTopEnd="@dimen/space_12"
            app:boxCornerRadiusBottomStart="@dimen/space_12"
            app:boxCornerRadiusBottomEnd="@dimen/space_12"
            app:boxStrokeColor="@color/channel_search_stroke"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/accent_alpha_35"
            app:hintTextColor="@color/primary_highlight"
            android:paddingBottom="@dimen/space_10"
            app:cursorColor="@color/white_alpha_45"
            android:visibility="gone"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChannelSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:inputType="text"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/ink"
                android:textSelectHandle="@drawable/search_handle"
                android:textSelectHandleLeft="@drawable/search_handle"
                android:textSelectHandleRight="@drawable/search_handle"
                android:textColorHint="@color/ink_dim"
                android:textCursorDrawable="@drawable/search_cursor" />

        </com.google.android.material.textfield.TextInputLayout>



        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="18dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/categoryContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_active"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chip_all"
                        android:textColor="@color/primary_highlight"
                        android:textSize="@dimen/text_body_sm"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="12dp"
            android:scrollbars="vertical" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>