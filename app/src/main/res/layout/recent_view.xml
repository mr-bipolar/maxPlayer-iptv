<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_card_icon_square">

        <ImageView
            android:id="@+id/mediaIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_play"
            app:tint="@color/ink_faint" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mediaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/recent_conference_feed"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mediaUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/recent_conference_feed_url"
            android:textColor="@color/ink_faint"
            android:textSize="@dimen/text_caption_sm" />
    </LinearLayout>

    <ImageView
        android:id="@+id/mediaFav"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@color/transparent"
        android:contentDescription="@string/cd_favorite"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_heart_outline"
        app:tint="@color/ink" />

    <ImageView
        android:id="@+id/mediaDelete"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@color/transparent"
        android:contentDescription="@string/cd_close"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:tint="@color/ink" />
</LinearLayout>

<View
android:layout_width="match_parent"
android:layout_height="1dp"
android:layout_marginStart="18dp"
android:layout_marginEnd="18dp"
android:background="@color/line_soft" />

</LinearLayout>