<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_black"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_channel_title"
        android:textColor="@color/primary_highlight"
        android:textSize="@dimen/text_display"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="@dimen/space_8"
        android:text="NAME"
        android:textColor="@color/white_alpha_45"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/channelNameInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Channel name"
        android:singleLine="true"
        android:inputType="textCapSentences"
        android:textColor="@color/white"
        android:textColorHint="@color/white_alpha_55"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_edit_text"
        android:textSize="@dimen/text_body" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="@dimen/space_8"
        android:text="URL"
        android:textColor="@color/white_alpha_45"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/channelUrlInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Channel URL"
        android:singleLine="true"
        android:inputType="textUri"
        android:imeOptions="actionDone"
        android:textColor="@color/white"
        android:textColorHint="@color/white_alpha_55"
        android:paddingHorizontal="12dp"
        android:textSize="@dimen/text_body"
        android:background="@drawable/bg_edit_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/save_channel_category_label"
        android:textColor="@color/white_alpha_45"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <!-- Tap to open the category picker -->
    <LinearLayout
        android:id="@+id/categoryField"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/txtCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/save_channel_category_hint"
            android:textColor="@color/white_alpha_75"
            android:textSize="@dimen/text_body" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:rotation="90"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/ink_dim" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@android:string/cancel"
            android:textColor="@color/ink_dim"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/update_channel_submit"
            android:textColor="@color/accent_ink"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>