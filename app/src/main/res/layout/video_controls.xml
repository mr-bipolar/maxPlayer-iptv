<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <View android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/exo_black_opacity_60"
        tools:ignore="PrivateResource" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/backPlayerView"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_white_soft"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playerIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_live"
                android:letterSpacing="0.03"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="@string/badge_live"
                android:textColor="@color/white"
                android:textSize="@dimen/text_micro"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playerTopLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/player_channel_name"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playerSubLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_channel_sub"
                android:textColor="@color/white_alpha_60"
                android:textSize="@dimen/text_caption_sm" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnFavorite"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white_soft"
            android:contentDescription="@string/cd_favorite"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart_outline"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnMore"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white_soft"
            android:contentDescription="@string/cd_more"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/white" />
    </LinearLayout>
    <LinearLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_bottom_scrim"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="30dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_circle_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/badge_live"
                android:textColor="@color/live"
                android:textSize="@dimen/text_caption_sm"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bufferSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/player_buffer"
                android:textColor="@color/white_alpha_55"
                android:textSize="@dimen/text_caption_sm" />
            <View
                android:layout_width="wrap_content"
                android:layout_height="6dp"
                android:layout_weight="1"
                />


            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123:56"
                android:textColor="@color/white_alpha_75"
                android:textSize="@dimen/text_caption_sm" />
            <TextView style="@style/ExoStyledControls.TimeText.Separator" />
            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123:56"
                android:textColor="@color/white_alpha_75"
                android:textSize="@dimen/text_caption_sm" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/exo_audio_track"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_speaker"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/player_ctl_audio"
                        android:textColor="@color/white_alpha_75"
                        android:textSize="@dimen/text_micro"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/subtitle_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_subtitles"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/player_ctl_subtitles"
                        android:textColor="@color/white_alpha_75"
                        android:textSize="@dimen/text_micro"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/exo_playback_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/player_ctl_speed"
                        android:textColor="@color/white_alpha_75"
                        android:textSize="@dimen/text_micro"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aspect_radio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_aspect_ratio"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/player_ctl_aspect"
                        android:textColor="@color/white_alpha_75"
                        android:textSize="@dimen/text_micro"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">


                <LinearLayout
                    android:id="@+id/playlistDrawer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_channels_list"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/player_ctl_channels"
                        android:textColor="@color/white_alpha_75"
                        android:textSize="@dimen/text_micro"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fullscreen_enter_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="0dp"
                    android:gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@id/fullscreen_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/exit_fullscreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/player_ctl_fullscreen"
                        android:textColor="@color/white_alpha_75"
                        android:textSize="@dimen/text_micro"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_progress_touch_height"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/player_progress_bottom_offset"
        app:bar_height="2dp"
        app:buffered_color="@color/white_alpha_55"
        app:played_color="@color/primary_highlight"
        app:scrubber_color="@color/primary_highlight"
        app:unplayed_color="@color/white_alpha_14" />

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:padding="@dimen/exo_styled_controls_padding"
        android:clipToPadding="false"
        android:layoutDirection="ltr"
        tools:ignore="PrivateResource">

        <include layout="@layout/exo_player_control_rewind_button"
            tools:ignore="PrivateResource" />

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_circle_white_soft">
            <ImageView
                android:id="@id/play_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:alpha="0.50"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play"
                app:tint="@color/primary_highlight" />
        </FrameLayout>

        <include layout="@layout/exo_player_control_ffwd_button"
            tools:ignore="PrivateResource" />


    </LinearLayout>

</merge>