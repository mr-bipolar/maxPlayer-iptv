<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_primary_background"
    tools:context=".navigates.FavoritesFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/favoritesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/space_64"
        tools:listitem="@layout/item_favorite" />

    <ScrollView
        android:id="@+id/emptyFav"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp"
            android:gravity="center">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_card_lg"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_heart_filled"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center"
                    app:tint="@color/accent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_favorites_yet"
                android:textSize="@dimen/text_title"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_fav"
                android:textSize="@dimen/text_body_sm"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:textColor="@color/ink_dim"
                android:gravity="center"
                android:maxWidth="280dp"
                android:lineSpacingMultiplier="1.15" />

            <LinearLayout
                android:id="@+id/browsePlaylists"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_accent"
                android:elevation="2dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse playlists"
                    android:textColor="@color/accent_ink"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <include
        android:id="@+id/audioPlayerOverlay"
        layout="@layout/audio_bg_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

</FrameLayout>
