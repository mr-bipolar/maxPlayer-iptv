<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".navigates.FavoritesFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/favoritesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_favorite" />

    <LinearLayout
        android:id="@+id/emptyFav"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_22"
        android:visibility="gone"
        android:gravity="center">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_lg"
            android:padding="@dimen/space_12">

            <ImageView
                android:layout_width="@dimen/space_22"
                android:layout_height="@dimen/space_22"
                android:src="@drawable/ic_empty"
                app:tint="@color/ink_dim" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_favorites_yet"
            android:textSize="@dimen/text_title"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/ink_dim"
            android:textStyle="bold"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_fav"
            android:textSize="@dimen/text_body"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/ink_faint"
            android:textAlignment="center"
            />
    </LinearLayout>

</FrameLayout>