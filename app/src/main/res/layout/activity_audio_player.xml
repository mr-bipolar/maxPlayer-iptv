<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_primary_background"
    tools:context=".player.media3.audio.AudioPlayerActivity">


    <LinearLayout
        android:id="@+id/audioPlayerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_audio_screen"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backAudioStreamBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_card"
                android:clickable="true"
                android:contentDescription="@string/cd_back"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                app:tint="@color/ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_playing_from"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/audio_station_sub"
                    android:textColor="@color/ink_faint"
                    android:textSize="@dimen/text_caption_sm" />

            </LinearLayout>

            <ImageView
                android:id="@+id/audioCatSaveBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_card"
                android:clickable="true"
                android:contentDescription="@string/cd_more"
                android:focusable="true"
                android:padding="11dp"
                android:layout_marginEnd="@dimen/space_8"
                android:src="@drawable/ic_add_music"
                app:tint="@color/ink" />

            <ImageView
                android:id="@+id/audioMoreBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_card"
                android:clickable="true"
                android:contentDescription="@string/cd_more"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/ink" />

        </LinearLayout>

        <!-- Flexible space above artwork -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Radio artwork -->
        <FrameLayout
            android:layout_width="@dimen/audio_art_size"
            android:layout_height="@dimen/audio_art_size"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_audio_art"
            android:padding="20dp">

            <ImageView
                android:id="@+id/audioArtwork"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_radio_large"
                android:importantForAccessibility="no"
                android:layout_gravity="center"
                app:tint="@color/ink_faint" />

        </FrameLayout>

        <!-- Station information -->
        <TextView
            android:id="@+id/audioStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/audio_station_name"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/audioStationSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/audio_station_sub"
            android:textColor="@color/ink_dim"
            android:textSize="@dimen/text_body_sm" />

        <!-- Flexible space between station info and controls -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7" />

        <!-- Player controls: Favorite, Play/Pause, Stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/audioFavoriteBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_card"
                android:clickable="true"
                android:contentDescription="@string/cd_favorite"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="@color/accent_dim" />

            <FrameLayout
                android:id="@+id/playPauseContainer"
                android:layout_width="@dimen/audio_play_main_size"
                android:layout_height="@dimen/audio_play_main_size"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:background="@drawable/bg_circle_accent"
                android:clickable="true"
                android:contentDescription="@string/audio_play"
                android:elevation="4dp"
                android:focusable="true">

                <ImageView
                    android:id="@+id/playPauseBtn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play"
                    app:tint="@color/accent_ink" />
            </FrameLayout>

            <ImageView
                android:id="@+id/audioStopBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_card"
                android:clickable="true"
                android:contentDescription="@string/cd_stop"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_stop"
                app:tint="@color/ink" />

        </LinearLayout>

        <!-- Status -->
        <LinearLayout
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_circle_ok" />

            <TextView
                android:id="@+id/fmStreamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audio_status_playing"
                android:textColor="@color/ok"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Optional stream bitrate -->
        <TextView
            android:id="@+id/bitrateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/ink_faint"
            android:textSize="@dimen/text_caption_sm"
            android:visibility="gone"
            tools:text="128 kbps"
            tools:visibility="visible" />

        <!-- Flexible space below metadata -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

    </LinearLayout>

</FrameLayout>
