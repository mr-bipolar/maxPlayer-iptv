<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_weight="1"
    android:background="@drawable/bg_card"
    android:clipToOutline="true"
    android:elevation="2dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/playlist_art_height"
        android:background="@drawable/bg_playlist_art">
        <ImageView
            android:id="@+id/playlistIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_tv"
            android:importantForAccessibility="no"
            android:layout_gravity="center"
            app:tint="@color/ink_dim" />
        <FrameLayout
            android:id="@+id/bookmarkIconView"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:visibility="invisible"
            android:background="@drawable/bg_badge_overlay">
            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_pin"
                android:importantForAccessibility="no"
                android:layout_gravity="center"
                app:tint="@color/primary_highlight" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/playlistMenuBtn"
            android:layout_width="22dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="false"
            android:background="@drawable/bg_btn_overflow">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_more_vert"
                android:importantForAccessibility="no"
                android:layout_gravity="center"
                app:tint="@color/ink" />
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">
        <TextView
            android:id="@+id/playlistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playlist_world_live_tv"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body_sm"
            android:textStyle="bold"
            android:maxLines="1"
            android:layout_marginBottom="3dp"/>
        <TextView
            android:id="@+id/playlistSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:maxLines="2"
            android:textColor="@color/ink_faint"
            android:textSize="@dimen/text_caption_sm"/>
    </LinearLayout>
</LinearLayout>