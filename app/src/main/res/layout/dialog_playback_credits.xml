<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/bg_card_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Playback Engine"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Media engine and project credits"
            android:textColor="@color/white_alpha_55"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="18dp"
            android:background="@color/ink_faint" />

        <!-- MPV CORE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDIA CORE"
            android:textColor="@color/warn_text"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="MPV"
            android:textColor="@color/white_alpha_75"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Core version: 0.41.0-UNKNOWN"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <!-- ANDROID INTEGRATION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="ANDROID INTEGRATION"
            android:textColor="@color/warn_text"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="mpv-android"
            android:textColor="@color/white_alpha_75"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Integration release: 2026-09-17"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/linkMpvAndroid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="View GitHub project ↗"
            android:textColor="@color/tv_player_accent"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- MAXPLAYER ENGINE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="PLAYER ENGINE"
            android:textColor="@color/warn_text"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="MPV Android Engine"
            android:textColor="@color/white_alpha_75"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Engine integration used by MaxPlayer."
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/linkMpvEngine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="View GitHub project ↗"
            android:textColor="@color/tv_player_accent"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="18dp"
            android:background="@color/credits_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/credit_info"
            android:textColor="@color/ink_dim"
            android:textSize="12sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnCloseCredits"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="CLOSE"
            android:textColor="@color/credits_button_text"
            android:backgroundTint="@color/tv_player_accent" />

    </LinearLayout>
</ScrollView>
