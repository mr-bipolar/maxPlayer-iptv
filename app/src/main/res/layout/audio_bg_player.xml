<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/miniPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="92dp"
        android:background="@drawable/bg_mini_player"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_10"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_10"
        android:paddingBottom="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_card_icon_square_sm">

            <ImageView
                android:layout_width="@dimen/space_16"
                android:layout_height="@dimen/space_16"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_radio"
                app:tint="@color/ink_faint" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_10"
            android:layout_marginEnd="@dimen/space_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniPlayerStationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/audio_station_name"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/miniPlayerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/audio_status_playing"
                    android:textColor="@color/ink_faint"
                    android:textSize="@dimen/text_caption_sm" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/miniPlayerPlayPause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/transparent"
            android:contentDescription="@string/cd_pause"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause"
            app:tint="@color/ink" />

        <ImageView
            android:id="@+id/miniPlayerExpand"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/transparent"
            android:contentDescription="@string/cd_expand"
            android:padding="@dimen/space_8"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_expand"
            app:tint="@color/ink" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>