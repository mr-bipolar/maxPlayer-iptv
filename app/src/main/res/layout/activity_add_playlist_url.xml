<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddPlaylistUrlActivity"
    android:background="@color/bg">


    <LinearLayout
        android:id="@+id/linearLayout7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backAddPlayListUrlOpen"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@color/transparent"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/title_add_playlist_url"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <View
            android:layout_width="38dp"
            android:layout_height="38dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout7">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="6dp"
                android:paddingEnd="18dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/label_playlist_url"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputPlaylistUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:text="@string/hint_playlist_url"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/label_playlist_name_optional"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputPlaylistName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_playlist_name"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="@dimen/text_body" />

                <LinearLayout
                    android:id="@+id/btnAddPlaylistCall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:background="@drawable/bg_pill_accent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="22dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_add_playlist"
                        android:textColor="@color/accent_ink"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statesLabel"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:letterSpacing="0.05"
                    android:text="@string/label_states"
                    android:textColor="@color/ink_faint"
                    android:textSize="@dimen/text_caption_sm"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/loadingState"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_card_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="7dp">

                    <ProgressBar
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="7dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/state_parsing"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/successCard"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_card_lg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_circle_ok_soft">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check"
                            app:tint="@color/ok" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_playlist_added"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_title_sm"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="14dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/playlistAddedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_title"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_channels"
                                android:textColor="@color/ink_faint"
                                android:textSize="@dimen/text_caption_sm" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/playlistAddedCatCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_title"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_categories"
                                android:textColor="@color/ink_faint"
                                android:textSize="@dimen/text_caption_sm" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/openPlaylistStream"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_pill_accent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="22dp"
                        android:paddingTop="13dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_open_playlist"
                            android:textColor="@color/accent_ink"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/errorCard"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_helper_note_error"
                    android:lineSpacingMultiplier="1.2"
                    android:padding="14dp"
                    android:text="@string/error_parse_playlist"
                    android:textColor="@color/error_text"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>