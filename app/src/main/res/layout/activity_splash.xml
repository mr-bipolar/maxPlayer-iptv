<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:theme="@style/ThemeOverlay.MaxPlayer.FullscreenContainer"
    tools:context=".SplashActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/splash_padding">

        <!-- Logo -->

        <!-- Brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/splash_logo_size"
                android:layout_height="@dimen/splash_logo_size"
                android:src="@drawable/ic_icon"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <!-- Product identity -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE TV  •  IPTV  •  MORE"
            android:textColor="#D6DCEC"
            android:textSize="@dimen/splash_subtitle_size"
            android:letterSpacing="0.18"
            android:fontFamily="sans"
            android:gravity="center"/>

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your Ultimate Live TV Experience"
            android:textColor="#AAB7D2"
            android:textSize="@dimen/splash_tagline_size"
            android:gravity="center"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_32"/>

    </LinearLayout>

    <!-- Loading indicator -->
    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/splash_loading_margin"
        android:orientation="vertical"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="@dimen/space_64"
        android:gravity="center">

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/warn_text"
            android:progressTint="@color/warn_text"
            android:progressBackgroundTint="#33445566" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Loading..."
            android:textColor="#D6DCEC"
            android:textSize="@dimen/splash_loading_text_size" />

    </LinearLayout>

</FrameLayout>