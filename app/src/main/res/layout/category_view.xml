<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/categoryView"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cat_card_height"
    android:background="@drawable/bg_cat_card"
    android:clipToOutline="true"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    >

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cat_scrim"/>

    <ImageView
        android:id="@+id/categoryIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tv"
        app:tint="@color/ink"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/categoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/categoryTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_dim"
            android:textSize="@dimen/text_caption_sm"/>

    </LinearLayout>

</FrameLayout>