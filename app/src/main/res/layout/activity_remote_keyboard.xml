<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_primary_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TV Remote"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/space_18"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Control and type on your TV"
                android:textSize="@dimen/text_body"
                android:textColor="@color/ink_faint" />

            <!-- Scan QR -->
            <LinearLayout
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_qrcode"
                    android:contentDescription="Scan QR code"
                    app:tint="@color/tv_player_accent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Scan TV QR Code"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/btnConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect"
                    android:textSize="13sp"
                    android:textColor="@color/primary_highlight"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- Connection status -->
            <LinearLayout
                android:id="@+id/layoutConnectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:visibility="gone"
                android:background="@drawable/bg_card">

                <View
                    android:id="@+id/viewConnectionIndicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_circle_ok" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtConnectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connected"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/txtTvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="MaxPlayer TV"
                        android:textSize="13sp"
                        android:textColor="@color/ink_dim" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnect"
                    android:textSize="13sp"
                    android:textColor="@color/primary_highlight"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- Text input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Text Input"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ink_dim" />

            <EditText
                android:id="@+id/editRemoteInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="100dp"
                android:gravity="top|start"
                android:padding="16dp"
                android:hint="Enter or paste playlist URL"
                android:inputType="textUri|textMultiLine"
                android:imeOptions="actionDone"
                android:maxLines="5"
                android:background="@drawable/bg_card_lg"
                android:textColorHint="@color/ink_faint"
                android:textSize="@dimen/text_body"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your input will appear on the TV automatically."
                android:textSize="13sp"
                android:textColor="@color/ink_faint" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent"
                android:padding="@dimen/space_12"
                android:textColor="@color/black_alpha_75"
                android:textStyle="bold"
                android:text="Clear" />

            <!-- D-pad section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="TV Controls"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ink_dim"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Navigate using the directional controls"
                android:textSize="12sp"
                android:textColor="@color/ink_faint"
                android:gravity="center" />

            <!-- Up -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnDpadUp"
                    android:layout_width="68dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:text="▲"
                    android:textSize="25sp"
                    android:textColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Up" />

            </LinearLayout>

            <!-- Left, OK, Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDpadLeft"
                    android:layout_width="68dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:text="◀"
                    android:textSize="25sp"
                    android:textColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Left" />

                <TextView
                    android:id="@+id/btnDpadCenter"
                    android:layout_width="68dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/bg_card_lg"
                    android:gravity="center"
                    android:text="OK"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_highlight"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Select" />

                <TextView
                    android:id="@+id/btnDpadRight"
                    android:layout_width="68dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:text="▶"
                    android:textSize="25sp"
                    android:textColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Right" />

            </LinearLayout>

            <!-- Down -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnDpadDown"
                    android:layout_width="68dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:text="▼"
                    android:textSize="25sp"
                    android:textColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Down" />

            </LinearLayout>

            <!-- Back -->
            <TextView
                android:id="@+id/btnDpadBack"
                android:layout_width="148dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:text="↶   Back"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Make sure both devices are connected to the same Wi-Fi network."
                android:textSize="12sp"
                android:textColor="@color/ink_faint"
                android:paddingBottom="@dimen/space_22"
                android:layout_marginBottom="@dimen/space_18" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
