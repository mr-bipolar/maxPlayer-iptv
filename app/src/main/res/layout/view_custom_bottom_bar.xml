<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@android:color/transparent"
    android:paddingTop="@dimen/space_22"
    >

    <!-- Bottom bar (Full width so the cradle curve calculates and renders properly) -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        app:elevation="@dimen/space_4"
        app:backgroundTint="@color/bg_1"
        app:fabAlignmentMode="center"
        app:fabCradleMargin="16dp"
        app:fabCradleRoundedCornerRadius="16dp"
        app:fabCradleVerticalOffset="0dp" />

    <!-- Four navigation items container (Margins applied here instead to keep the floating visual) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_home"
                app:tint="@color/nav_item_icon_colors" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:text="Home"
                android:textColor="@color/nav_item_colors"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Playlists -->
        <LinearLayout
            android:id="@+id/navPlaylists"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_playlists"
                app:tint="@color/nav_item_icon_colors" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:text="Playlists"
                android:textColor="@color/nav_item_colors"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Space for center Channels button -->
        <Space
            android:layout_width="64dp"
            android:layout_height="match_parent" />

        <!-- Favorites -->
        <LinearLayout
            android:id="@+id/navFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_heart_outline"
                app:tint="@color/nav_item_icon_colors" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:text="Favorites"
                android:textColor="@color/nav_item_colors"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_clock"
                app:tint="@color/nav_item_icon_colors" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:text="History"
                android:textColor="@color/nav_item_colors"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Raised center Channels button properly cradled -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnChannels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Channels"
        android:src="@drawable/ic_playlist_filled"
        app:backgroundTint="#C9A96E"
        app:fabSize="normal"
        app:layout_anchor="@id/bottomAppBar"
        app:tint="@color/accent_ink"
        android:elevation="@dimen/space_4"
        android:layout_marginBottom="28dp"
     />

</androidx.coordinatorlayout.widget.CoordinatorLayout>