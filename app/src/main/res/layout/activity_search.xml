<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_primary_background">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_12"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_8">

        <ImageButton
            android:id="@+id/searchBackBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <!-- Search Field -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_6"
            android:layout_marginEnd="@dimen/space_6"
            android:background="@drawable/bg_search_field">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/ink_faint" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint_channels"
                android:textColorHint="@color/ink_faint"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/searchClearBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_clear"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/ink_faint" />
        </FrameLayout>
    </LinearLayout>

    <!-- Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Results list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="@dimen/space_16"
            android:scrollbars="none"
            android:visibility="gone" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/searchLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Prompt State (before user types) -->
        <LinearLayout
            android:id="@+id/searchPromptView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="visible">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_card_lg"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/accent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_prompt_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_prompt_body"
                android:textColor="@color/ink_dim"
                android:textSize="@dimen/text_body_sm"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:maxWidth="280dp" />
        </LinearLayout>

        <!-- Empty / No Results State -->
        <LinearLayout
            android:id="@+id/searchEmptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_card_lg"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/ink_faint" />
            </FrameLayout>

            <TextView
                android:id="@+id/searchEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_no_results_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/searchEmptyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_dim"
                android:textSize="@dimen/text_body_sm"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:maxWidth="280dp" />
        </LinearLayout>

        <!-- Error State -->
        <TextView
            android:id="@+id/searchErrorView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/search_error"
            android:textColor="@color/ink_dim"
            android:textSize="@dimen/text_body_sm"
            android:gravity="center"
            android:padding="@dimen/space_18"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
