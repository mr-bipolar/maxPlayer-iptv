<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".navigates.PlaylistsFragment"
    android:background="@color/bg">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="@dimen/space_8"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:background="@drawable/bg_search_field">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_search"
                    android:importantForAccessibility="no"
                    app:tint="@color/ink_faint" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hint_search_channels"
                        android:textColor="@color/ink_faint"
                        android:textSize="@dimen/text_body"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingStart="18dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="14dp"
                    android:clipToPadding="false">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_chip_active"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/toggle_gallery"
                                android:textColor="@color/accent"
                                android:textSize="@dimen/text_body_sm"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/toggle_list"
                                android:textColor="@color/ink_dim"
                                android:textSize="@dimen/text_body_sm"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_marginEnd="8dp">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_filter"
                                android:importantForAccessibility="no"
                                android:layout_marginEnd="6dp"
                                app:tint="@color/ink_dim" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_filter"
                                android:textColor="@color/ink_dim"
                                android:textSize="@dimen/text_body_sm"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_marginEnd="8dp">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_sort"
                                android:importantForAccessibility="no"
                                android:layout_marginEnd="6dp"
                                app:tint="@color/ink_dim" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_sort"
                                android:textColor="@color/ink_dim"
                                android:textSize="@dimen/text_body_sm"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/section_categories"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_title_sm"
                        android:textStyle="bold"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="12dp">
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cat_card_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cat_card"
                        android:clipToOutline="true"
                        android:layout_marginEnd="6dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_cat_scrim"/>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_tv"
                            android:importantForAccessibility="no"
                            android:alpha="0.5"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            app:tint="@color/ink" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="bottom|start"
                            android:padding="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_live_tv"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_live_tv_count"
                                android:textColor="@color/ink_dim"
                                android:textSize="@dimen/text_caption_sm"/>
                        </LinearLayout>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cat_card_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cat_card"
                        android:clipToOutline="true"
                        android:layout_marginStart="6dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_cat_scrim"/>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cat_sport"
                            android:importantForAccessibility="no"
                            android:alpha="0.5"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            app:tint="@color/ink" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="bottom|start"
                            android:padding="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_sports"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_sports_count"
                                android:textColor="@color/ink_dim"
                                android:textSize="@dimen/text_caption_sm"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="12dp">
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cat_card_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cat_card"
                        android:clipToOutline="true"
                        android:layout_marginEnd="6dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_cat_scrim"/>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cat_news"
                            android:importantForAccessibility="no"
                            android:alpha="0.5"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            app:tint="@color/ink" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="bottom|start"
                            android:padding="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_news"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_news_count"
                                android:textColor="@color/ink_dim"
                                android:textSize="@dimen/text_caption_sm"/>
                        </LinearLayout>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cat_card_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cat_card"
                        android:clipToOutline="true"
                        android:layout_marginStart="6dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_cat_scrim"/>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cat_movies"
                            android:importantForAccessibility="no"
                            android:alpha="0.5"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            app:tint="@color/ink" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="bottom|start"
                            android:padding="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_movies"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_movies_count"
                                android:textColor="@color/ink_dim"
                                android:textSize="@dimen/text_caption_sm"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="12dp">
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cat_card_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cat_card"
                        android:clipToOutline="true"
                        android:layout_marginEnd="6dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_cat_scrim"/>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cat_kids"
                            android:importantForAccessibility="no"
                            android:alpha="0.5"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            app:tint="@color/ink" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="bottom|start"
                            android:padding="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_kids"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_kids_count"
                                android:textColor="@color/ink_dim"
                                android:textSize="@dimen/text_caption_sm"/>
                        </LinearLayout>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/cat_card_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cat_card"
                        android:clipToOutline="true"
                        android:layout_marginStart="6dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_cat_scrim"/>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_radio"
                            android:importantForAccessibility="no"
                            android:alpha="0.5"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            app:tint="@color/ink" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="bottom|start"
                            android:padding="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_radio"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cat_radio_count"
                                android:textColor="@color/ink_dim"
                                android:textSize="@dimen/text_caption_sm"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>



</FrameLayout>