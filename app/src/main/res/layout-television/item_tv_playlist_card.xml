<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tvPlaylistCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clipChildren="false"
    android:focusable="true"
    android:clickable="true"
    android:orientation="vertical"
    android:stateListAnimator="@animator/tv_focus_scale"
    tools:ignore="MissingDefaultResource">

    <FrameLayout
        android:id="@+id/cardArt"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="@drawable/bg_tv_card_art"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/cardIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_nav_playlists"
            android:importantForAccessibility="no"
            app:tint="@color/ink_dim" />

        <TextView
            android:id="@+id/cardTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge_overlay"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="LIVE"
            android:textColor="@color/accent"
            android:textSize="@dimen/tv_text_caption"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white_alpha_55"
            android:textSize="@dimen/tv_card_caption" />
    </LinearLayout>
</LinearLayout>
