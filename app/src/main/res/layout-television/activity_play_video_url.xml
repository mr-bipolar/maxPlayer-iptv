<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" tools:context=".PlayVideoUrlActivity">
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_tv_plain" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingStart="@dimen/tv_margin_h" android:paddingEnd="@dimen/tv_margin_h" android:paddingTop="@dimen/tv_margin_v" android:paddingBottom="@dimen/tv_margin_v">
            <LinearLayout android:id="@+id/linearLayout4" android:layout_width="680dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_tv_source_tile_default" android:padding="@dimen/space_28">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="@string/title_play_video_url" android:textColor="@color/white" android:textSize="@dimen/tv_text_title" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/space_6" android:layout_marginBottom="@dimen/space_24" android:text="@string/tv_src_video_desc" android:textColor="@color/ink_dim" android:textSize="@dimen/tv_text_button" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_8" android:text="@string/label_video_url" android:textColor="@color/ink_dim" android:textSize="@dimen/tv_text_label" android:textStyle="bold" />
                <EditText android:id="@+id/videoUrlForPlay" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="@dimen/space_16" android:background="@drawable/bg_input" android:focusable="true" android:focusableInTouchMode="true" android:importantForAutofill="no" android:inputType="textUri" android:hint="@string/hint_url_generic" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16" android:singleLine="true" android:textColor="@color/ink" android:textColorHint="@color/ink_faint" android:textSize="@dimen/tv_text_body" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_8" android:text="@string/label_name_optional" android:textColor="@color/ink_dim" android:textSize="@dimen/tv_text_label" android:textStyle="bold" />
                <EditText android:id="@+id/videoNameForPlay" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="@dimen/space_20" android:background="@drawable/bg_input" android:focusable="true" android:importantForAutofill="no" android:inputType="textUri" android:hint="@string/hint_name_conference" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/space_16" android:singleLine="true" android:textColor="@color/ink" android:textColorHint="@color/ink_faint" android:textSize="@dimen/tv_text_body" />
                <LinearLayout android:id="@+id/playVideoUrl" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_tv_btn_primary" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/tv_focus_scale_sm" android:gravity="center">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="@dimen/space_8" android:importantForAccessibility="no" android:src="@drawable/ic_play" app:tint="@color/accent_ink" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/btn_play" android:textColor="@color/accent_ink" android:textSize="@dimen/tv_text_button" android:textStyle="bold" />
                </LinearLayout>
                <ScrollView android:id="@+id/scrollViewForRecentUrls" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/linearLayout3" android:layout_width="0dp" android:layout_height="0dp"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <ImageButton android:id="@+id/backPlayVideoUrl" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="top|start" android:layout_margin="@dimen/tv_margin_v" android:background="@drawable/bg_tv_btn_ghost" android:contentDescription="@string/cd_back" android:focusable="true" android:src="@drawable/ic_back" android:stateListAnimator="@animator/tv_focus_scale_sm" app:tint="@color/ink_dim" />
    <include android:id="@+id/streamErrorOverlay" layout="@layout/stream_error" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
    <include android:id="@+id/loaderOverlay" layout="@layout/loader_view" android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
