<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_dialog_panel"
    android:padding="28dp"
    tools:ignore="MissingDefaultResource">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_channel_title"
        android:textColor="@color/white"
        android:textSize="@dimen/tv_text_row_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp"
        android:text="Channel Name"
        android:textColor="@color/ink_dim"
        android:textSize="@dimen/tv_text_label" />

    <EditText
        android:id="@+id/channelNameInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Enter channel name"
        android:singleLine="true"
        android:inputType="textCapSentences"
        android:textColor="@color/white"
        android:textColorHint="@color/ink_faint"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_tv_dialog_field"
        android:textSize="@dimen/tv_text_body"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="Stream URL"
        android:textColor="@color/ink_dim"
        android:textSize="@dimen/tv_text_label" />

    <EditText
        android:id="@+id/channelUrlInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Enter stream URL"
        android:singleLine="true"
        android:inputType="textUri"
        android:imeOptions="actionDone"
        android:textColor="@color/white"
        android:textColorHint="@color/ink_faint"
        android:paddingHorizontal="16dp"
        android:textSize="@dimen/tv_text_body"
        android:background="@drawable/bg_tv_dialog_field"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="@string/save_channel_category_label"
        android:textColor="@color/ink_dim"
        android:textSize="@dimen/tv_text_label" />

    <!-- TV Category field -->
    <LinearLayout
        android:id="@+id/categoryField"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_tv_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:stateListAnimator="@animator/tv_focus_scale_sm">

        <TextView
            android:id="@+id/txtCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/save_channel_category_hint"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_text_body" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/ink_dim" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_tv_btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@animator/tv_focus_scale_sm"
            android:text="@android:string/cancel"
            android:textColor="@color/ink_dim"
            android:textSize="@dimen/tv_text_body" />

        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_tv_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:stateListAnimator="@animator/tv_focus_scale_sm"
            android:text="@string/update_channel_submit"
            android:textColor="@color/accent_ink"
            android:textSize="@dimen/tv_text_body"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
