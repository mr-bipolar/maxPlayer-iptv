<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tv_dialog_panel"
    android:orientation="vertical"
    android:padding="24dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="MissingDefaultResource">

    <TextView
        android:id="@+id/tvActionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="@dimen/tv_text_row_title"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Action Title" />

    <TextView
        android:id="@+id/tvActionSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:textColor="@color/ink_dim"
        android:textSize="@dimen/tv_text_label"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Action Subtitle" />

    <!-- Primary Action (Play / Open) -->
    <LinearLayout
        android:id="@+id/tvActionPrimary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_tv_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:stateListAnimator="@animator/tv_focus_scale_sm">

        <ImageView
            android:id="@+id/tvActionPrimaryIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_play"
            app:tint="@color/accent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvActionPrimaryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_text_body"
            android:textStyle="bold"
            tools:text="Play Stream" />
    </LinearLayout>

    <!-- Edit Action -->
    <LinearLayout
        android:id="@+id/tvActionEdit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tv_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:stateListAnimator="@animator/tv_focus_scale_sm">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/primary_highlight"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvActionEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_text_body"
            android:textStyle="bold"
            tools:text="Edit" />
    </LinearLayout>

    <!-- Delete Action -->
    <LinearLayout
        android:id="@+id/tvActionDelete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tv_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:stateListAnimator="@animator/tv_focus_scale_sm">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_trash"
            app:tint="@color/error_text"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvActionDeleteText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/error_text"
            android:textSize="@dimen/tv_text_body"
            android:textStyle="bold"
            tools:text="Delete" />
    </LinearLayout>

    <!-- Cancel Action -->
    <LinearLayout
        android:id="@+id/tvActionCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tv_btn_ghost"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:stateListAnimator="@animator/tv_focus_scale_sm">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"
            android:textColor="@color/ink_dim"
            android:textSize="@dimen/tv_text_body" />
    </LinearLayout>

</LinearLayout>
