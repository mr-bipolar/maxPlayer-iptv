<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_primary_background" tools:context=".filepicker.MediaBrowserActivity">
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_tv_plain" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="@dimen/tv_margin_h" android:paddingEnd="@dimen/tv_margin_h" android:paddingTop="@dimen/tv_margin_v" android:paddingBottom="@dimen/tv_margin_v">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="84dp" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnBackFolder" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="@dimen/space_16" android:background="@drawable/bg_tv_btn_ghost" android:contentDescription="@string/cd_back" android:focusable="true" android:src="@drawable/ic_back" android:stateListAnimator="@animator/tv_focus_scale_sm" app:tint="@color/ink_dim" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="@dimen/space_16">
                <TextView android:id="@+id/txtTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/iptv_browser" android:textColor="@color/white" android:textSize="@dimen/tv_text_title" android:textStyle="bold" />
                <TextView android:id="@+id/txtPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1" android:text="@string/select_folder" android:textColor="@color/ink_dim" android:textSize="@dimen/tv_text_body" />
            </LinearLayout>
            <Button android:id="@+id/btnChooseFolder" android:layout_width="wrap_content" android:layout_height="56dp" android:minWidth="180dp" android:background="@drawable/bg_tv_select_folder_button" android:backgroundTint="@null" app:backgroundTint="@null" android:focusable="true" android:stateListAnimator="@animator/tv_focus_scale_sm" android:text="@string/select_folder" android:textColor="@color/tv_select_folder_text" android:textSize="@dimen/tv_text_button" android:textStyle="bold" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="@dimen/space_12" android:layout_marginBottom="@dimen/space_12" android:background="@color/line" />
        <TextView android:id="@+id/txtEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/space_24" android:text="No supported media files in this folder" android:textColor="@color/ink_dim" android:textSize="@dimen/tv_text_body" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMedia" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false" android:paddingStart="@dimen/space_8" android:paddingEnd="@dimen/space_8" android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_16" />
    </LinearLayout>
</FrameLayout>
