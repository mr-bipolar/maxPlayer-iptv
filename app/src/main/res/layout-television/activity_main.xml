<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="@color/bg">

    <!-- 1. Cinematic Full-Bleed Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wall"
        android:contentDescription="@null" />

    <!-- 2. Dark/Cinematic Gradient Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_home_overlay" />

    <!-- 3. Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="32dp"
        android:paddingBottom="28dp">

        <!-- Top Bar: Branding on Left, Settings/Favorites on Right -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <!-- App Title & Legal Disclaimer (inspired by your reference image) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAX PLAYER"
                    android:textColor="@color/ink"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="This application does not host or provide any media content.\nPlease use your own legally obtained media sources."
                    android:textColor="@color/ink_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Top-Right Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/tvSettingsButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_tv_nav_item"
                    android:src="@drawable/ic_settings_gear"
                    android:scaleType="center"
                    android:padding="14dp"
                    android:contentDescription="Settings"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/ink" />

                <ImageButton
                    android:id="@+id/tvFavoritesButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_tv_nav_item"
                    android:src="@drawable/ic_heart_filled"
                    android:scaleType="center"
                    android:padding="14dp"
                    android:contentDescription="Favorites"
                    android:focusable="true"
                    android:clickable="true"
                    app:tint="@color/ink" />

            </LinearLayout>
        </RelativeLayout>

        <!-- Main Navigation Cards (Centered Horizontally) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_40"
                android:orientation="horizontal">

                <!-- Explore Card -->
                <LinearLayout
                    android:id="@+id/tvExploreCard"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_tv_home_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_regional"
                        android:contentDescription="@null"
                        app:tint="@color/ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Explore"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Live TV Card -->
                <LinearLayout
                    android:id="@+id/tvLiveCard"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_tv_home_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_tv"
                        android:contentDescription="@null"
                        app:tint="@color/ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Live TV"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Playlists Card -->
                <LinearLayout
                    android:id="@+id/tvPlaylistsCard"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_tv_home_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_nav_playlists"
                        android:contentDescription="@null"
                        app:tint="@color/ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Playlists"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Categories Card -->
                <LinearLayout
                    android:id="@+id/tvCategoriesCard"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_tv_home_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_other"
                        android:contentDescription="@null"
                        app:tint="@color/ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Categories"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Bottom Actions Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <!-- Import Playlist Button -->
            <LinearLayout
                android:id="@+id/tvImportButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_tv_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="22dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_plus"
                    android:contentDescription="@null"
                    app:tint="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Import Playlist"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- MPV Credit Subtext -->
            <LinearLayout
                android:id="@+id/tvMpvCredit"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_toStartOf="@id/tvRemoteButton"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mpv_symbolic"
                    android:contentDescription="MPV"
                    app:tint="@color/ink_dim" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_12"
                    android:text="Powered by MPV"
                    android:textColor="@color/ink_dim"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Remote Connect Button -->
            <ImageButton
                android:id="@+id/tvRemoteButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_tv_nav_item"
                android:src="@drawable/ic_remote"
                android:scaleType="center"
                android:padding="14dp"
                android:contentDescription="Remote Connect"
                android:focusable="true"
                android:clickable="true"
                app:tint="@color/ink" />

        </RelativeLayout>

    </LinearLayout>

</FrameLayout>